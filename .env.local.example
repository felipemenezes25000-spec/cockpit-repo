# MODELO — não coloque valores reais aqui. Este arquivo VAI para o repositório.
#
# Copie para .env.local e preencha lá. O .env.local está no .gitignore.
#
# Onde achar cada valor:
#   Supabase > seu projeto > Project Settings > API

# URL do projeto. Ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon public" (ou "publishable"). Ela é publicada no navegador por
# natureza — quem protege os dados é a RLS do banco, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: a chave "service_role" ignora toda a RLS.
# Não coloque aqui, não use no navegador e não mande por mensagem.
# Se algum dia for necessária, entra só como variável de ambiente do servidor.

# Origem canônica do link público de assinatura (/assinar/<token>), SÓ do
# servidor (sem NEXT_PUBLIC_). Só protocolo, domínio e porta — sem caminho,
# sem barra no fim, sem usuário. https obrigatório (http só em localhost).
#   Produção:  ORIGEM_PUBLICA=https://seu-dominio.com.br
#   Local:     ORIGEM_PUBLICA=http://localhost:3000
# Vazia, o endereço sai do cabeçalho Host da requisição, conferido — mas em
# produção (NODE_ENV=production) vazia só vale para localhost: fora dele o
# link é recusado até ORIGEM_PUBLICA ser preenchida. Preenchida
# com valor inválido, a geração do link é recusada (não cai no cabeçalho).
ORIGEM_PUBLICA=

# Segredo do servidor da assinatura eletrônica (0032), SÓ do servidor. As
# funções públicas de assinatura só atendem quem o apresenta — sem ele, o
# link de assinatura mostra "não foi possível abrir agora". O banco guarda
# apenas o SHA-256 (tabela private.segredo_do_servidor).
#   Local:     npm run local:usuarios grava o hash do segredo de
#              desenvolvimento (supabase/usuarios-locais.json); copie o
#              mesmo valor para cá.
#   Produção:  gere um valor novo (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"),
#              guarde na Vercel e grave o SHA-256 dele no banco de produção:
#              insert into private.segredo_do_servidor (id, hash) values (1, '<sha256 hex>')
#                on conflict (id) do update set hash = excluded.hash, definido_em = now();
# Mínimo de 32 caracteres. Trocar o segredo = trocar nos dois lugares.
ASSINATURA_SEGREDO_SERVIDOR=

# E-mail do sistema (código de verificação da assinatura). Sem SMTP_URL, o
# painel do link não oferece o código por e-mail.
#   SMTP_URL=smtps://usuario:senha@smtp.provedor.com.br:465
#   SMTP_REMETENTE="Clínica <nao-responda@seu-dominio.com.br>"
SMTP_URL=
SMTP_REMETENTE=

# Só desenvolvimento e testes: grava cada e-mail como JSON nesta pasta em vez
# de enviar (os testes E2E leem o código de lá). Ignorado em produção.
#   EMAIL_PASTA=e2e/.emails
EMAIL_PASTA=
