# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# O .env.local está no .gitignore e nunca vai para o repositório.
#
# Onde achar cada valor:
#   Supabase > seu projeto > Project Settings > API

# URL do projeto. Ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon public". Ela é publicada no navegador por natureza — quem protege
# os dados é a RLS do banco, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: a chave "service_role" ignora toda a RLS.
# Não coloque aqui, não use no navegador e não mande por mensagem.
# Se algum dia for necessária, entra só como variável de ambiente do servidor.
