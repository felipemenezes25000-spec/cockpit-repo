{
  "name": "cockpit-consultorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:tipos": "supabase gen types typescript --linked --schema public > src/lib/supabase/tipos-banco.ts",
    "dados:exemplo": "supabase db query --linked --file supabase/dados-exemplo.sql -o table",
    "dados:limpar": "supabase db query --linked --file supabase/dados-exemplo-limpar.sql -o table"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
