{
  "name": "cockpit-consultorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "supabase db push",
    "db:tipos": "node scripts/gerar-tipos.mjs --linked",
    "db:tipos:local": "node scripts/gerar-tipos.mjs --local",
    "dados:exemplo": "supabase db query --linked --file supabase/dados-exemplo.sql -o table",
    "dados:limpar": "supabase db query --linked --file supabase/dados-exemplo-limpar.sql -o table",
    "local:usuarios": "node scripts/usuarios-locais.mjs",
    "test:banco": "node scripts/testes-banco.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.26",
    "jsdom": "^26.1.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vercel": "^58.7.1",
    "vitest": "^3.2.7"
  }
}
